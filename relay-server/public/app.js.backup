let ws = null;
let currentDevice = null;
let videoDecoder = null;
let frameCount = 0;
let lastFrameTime = 0;
const canvas = document.getElementById('videoCanvas');
const ctx = canvas.getContext('2d');

// H.264 配置信息
let h264Description = null;  // 存储 SPS/PPS
let decoderConfigured = false; // 标记解码器是否已配置
let frameTimestamp = 0; // 帧时间戳计数器
let pendingNalUnits = [];
let haveVclInCurrentAU = false;
let keyFramesSkipped = 0; // 统计跳过的非关键帧数量
let lastKeyFrameRequest = 0; // 上次请求关键帧的时间

// 调整 Canvas 显示尺寸以适应容器
function adjustCanvasSize() {
    // 使用 viewer 的尺寸，而不是 videoContainer
    const viewer = document.querySelector('.viewer');
    const controls = document.querySelector('.controls');
    
    const viewerWidth = viewer.clientWidth;
    const viewerHeight = viewer.clientHeight;
    const controlsHeight = controls ? controls.offsetHeight : 60;
    
    // 可用空间 = viewer 高度 - 控制栏高度
    const containerWidth = viewerWidth;
    const containerHeight = viewerHeight - controlsHeight;
    
    
    const videoWidth = canvas.width;
    const videoHeight = canvas.height;
    
    if (videoWidth === 0 || videoHeight === 0) {
        return;
    }
    
    // 留出一些边距
    const maxWidth = containerWidth - 20;
    const maxHeight = containerHeight - 20;
    
    // 计算缩放比例，保持宽高比
    const scaleX = maxWidth / videoWidth;
    const scaleY = maxHeight / videoHeight;
    const scale = Math.min(scaleX, scaleY, 1); // 不要放大，最大1倍
    
    // 设置显示尺寸
    const displayWidth = Math.floor(videoWidth * scale);
    const displayHeight = Math.floor(videoHeight * scale);
    
    canvas.style.setProperty('width', displayWidth + 'px', 'important');
    canvas.style.setProperty('height', displayHeight + 'px', 'important');
    

}

// 窗口大小变化时重新调整
window.addEventListener('resize', () => {
    if (canvas.width > 0 && canvas.height > 0) {
        adjustCanvasSize();
    }
})

// 请求关键帧
function requestKeyFrame() {
    if (!ws || ws.readyState !== WebSocket.OPEN) {
        console.warn('[VIDEO-DIAG] Cannot request key frame: WebSocket not connected');
        return;
    }
    
    const now = Date.now();
    // 限制请求频率，最多每2秒一次
    if (now - lastKeyFrameRequest < 2000) {
        console.log('[VIDEO-DIAG] Skipping key frame request: too frequent');
        return;
    }
    
    lastKeyFrameRequest = now;
    console.log('[VIDEO-DIAG] Requesting key frame from server...');
    
    ws.send(JSON.stringify({
        type: 'requestKeyFrameDirect'
    }));
}

// 连接到中继服务器
function connectToServer() {
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = `${protocol}//${window.location.host}?type=web`;
    
    ws = new WebSocket(wsUrl);
    ws.binaryType = 'arraybuffer';
    
    ws.onopen = () => {

        updateStatus(true, '已连接到服务器');
    };
    
    ws.onmessage = async (event) => {
        
        
        if (typeof event.data === 'string') {
            // JSON 消息（控制消息、设备列表等）
            
            const message = JSON.parse(event.data);
            handleControlMessage(message);
        } else {
            // 二进制数据（视频流）
            
            handleVideoData(event.data);
        }
    };
    
    ws.onerror = (error) => {
        
        updateStatus(false, '连接错误');
    };
    
    ws.onclose = () => {
        
        updateStatus(false, '连接已断开');
        setTimeout(connectToServer, 3000); // 3秒后重连
    };
}

// 处理控制消息
function handleControlMessage(message) {
    
    if (message.type === 'deviceList') {
        updateDeviceList(message.devices);
    }
}

// 处理视频数据
async function handleVideoData(data) {
    console.log(`[VIDEO-DIAG] Received video data. Size: ${data.byteLength} bytes.`);
    try {
        const arrayBuffer = data;
        // 减少日志频率：只在第一次或每1000帧记录一次
        if (!window.videoFrameCount) window.videoFrameCount = 0;
        window.videoFrameCount++;
        if (window.videoFrameCount % 1000 === 0) {
           
        }
        
        // 检查 WebCodecs API 支持
        if (!('VideoDecoder' in window)) {
            
            // 显示提示但不返回，让用户看到收到了数据
            const canvas = document.getElementById('videoCanvas');
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, 800, 600);
            ctx.fillStyle = '#f00';
            ctx.font = '20px Arial';
            ctx.fillText('WebCodecs API 不支持', 50, 50);
            ctx.fillText('请使用 Chrome/Edge 94+ 浏览器', 50, 100);
            ctx.fillText(`已收到 ${arrayBuffer.byteLength} 字节视频数据`, 50, 150);
            return;
        }
        
        // 初始化解码器
        if (!videoDecoder) {
            console.log('[VIDEO-DIAG] Initializing video decoder for the first time.');
            initVideoDecoder();
        }
        
        // 解析 WebSocket 帧头（如果有）
        const uint8Array = new Uint8Array(arrayBuffer);
        
        // scrcpy 发送的是原始 H.264 数据，需要分解为 NAL 单元
        decodeH264Data(uint8Array);
        
    } catch (e) {
        console.error('Error handling video data:', e);
    }
}

// 从 H.264 流中提取 SPS/PPS 并生成 description
function extractH264Config(data) {
    const nalUnits = [];
    let i = 0;
    
    console.log('[VIDEO-DIAG] extractH264Config: Input data size:', data.length);
    console.log('[VIDEO-DIAG] extractH264Config: First 20 bytes hex:', Array.from(data.slice(0, 20)).map(b => b.toString(16).padStart(2, '0')).join(' '));
    
    // 查找所有 NAL 单元
    while (i < data.length - 4) {
        // 查找起始码 0x00 0x00 0x00 0x01 或 0x00 0x00 0x01
        let startCodeLength = 0;
        if (data[i] === 0 && data[i+1] === 0 && data[i+2] === 0 && data[i+3] === 1) {
            startCodeLength = 4;
        } else if (data[i] === 0 && data[i+1] === 0 && data[i+2] === 1) {
            startCodeLength = 3;
        } else {
            i++;
            continue;
        }
        
        const nalStart = i + startCodeLength;
        const nalType = data[nalStart] & 0x1F;
        console.log('[VIDEO-DIAG] Found NAL type:', nalType, 'at position:', nalStart);
        
        // 找到下一个起始码
        let nalEnd = nalStart + 1;
        while (nalEnd < data.length - 3) {
            if ((data[nalEnd] === 0 && data[nalEnd+1] === 0 && data[nalEnd+2] === 0 && data[nalEnd+3] === 1) ||
                (data[nalEnd] === 0 && data[nalEnd+1] === 0 && data[nalEnd+2] === 1)) {
                break;
            }
            nalEnd++;
        }
        
        if (nalEnd > nalStart) {
            const nalUnit = data.slice(nalStart, nalEnd);
            console.log('[VIDEO-DIAG] NAL unit size:', nalUnit.length, 'type:', nalType, 'first bytes:', Array.from(nalUnit.slice(0, 5)).map(b => b.toString(16).padStart(2, '0')).join(' '));
            nalUnits.push({
                type: nalType,
                data: nalUnit
            });

        }
        
        i = nalEnd;
    }
    
    // 查找 SPS (type 7) 和 PPS (type 8)
    const sps = nalUnits.find(nal => nal.type === 7);
    const pps = nalUnits.find(nal => nal.type === 8);
    
    console.log('[VIDEO-DIAG] Found NAL units:', nalUnits.length, 'SPS:', !!sps, 'PPS:', !!pps);
    if (sps) console.log('[VIDEO-DIAG] SPS size:', sps.data.length, 'first bytes:', Array.from(sps.data.slice(0, 10)).map(b => b.toString(16).padStart(2, '0')).join(' '));
    if (pps) console.log('[VIDEO-DIAG] PPS size:', pps.data.length, 'first bytes:', Array.from(pps.data.slice(0, 10)).map(b => b.toString(16).padStart(2, '0')).join(' '));
    
    if (sps && pps) {
       
        
        // 从 SPS 提取 profile/level 信息
        const profile = sps.data[1];
        const constraints = sps.data[2];
        const level = sps.data[3];
        
        // 构建正确的 codec 字符串
        const codecString = `avc1.${profile.toString(16).padStart(2, '0')}${constraints.toString(16).padStart(2, '0')}${level.toString(16).padStart(2, '0')}`;
        console.log('[VIDEO-DIAG] Generated codec string:', codecString);
        console.log('[VIDEO-DIAG] SPS profile:', profile.toString(16), 'constraints:', constraints.toString(16), 'level:', level.toString(16));
        
        
        // 保存到全局变量供后续使用
        window.detectedCodec = codecString;
        
        // 构建 AVC Decoder Configuration Record (avcC)
        // 格式: [1字节version][3字节profile/level][1字节lengthSize] [SPS数量][SPS长度][SPS数据][PPS数量][PPS长度][PPS数据]
        const avcC = new Uint8Array(11 + sps.data.length + pps.data.length);
        let offset = 0;
        
        avcC[offset++] = 1; // configurationVersion
        avcC[offset++] = sps.data[1]; // AVCProfileIndication
        avcC[offset++] = sps.data[2]; // profile_compatibility
        avcC[offset++] = sps.data[3]; // AVCLevelIndication
        avcC[offset++] = 0xFF; // lengthSizeMinusOne (4 bytes)
        
        // SPS
        avcC[offset++] = 0xE1; // numOfSequenceParameterSets (1)
        avcC[offset++] = (sps.data.length >> 8) & 0xFF;
        avcC[offset++] = sps.data.length & 0xFF;
        avcC.set(sps.data, offset);
        offset += sps.data.length;
        
        // PPS
        avcC[offset++] = 1; // numOfPictureParameterSets
        avcC[offset++] = (pps.data.length >> 8) & 0xFF;
        avcC[offset++] = pps.data.length & 0xFF;
        avcC.set(pps.data, offset);
        
        
        console.log('[VIDEO-DIAG] Generated avcC data. Size:', avcC.length);
        console.log('[VIDEO-DIAG] avcC hex:', Array.from(avcC).map(b => b.toString(16).padStart(2, '0')).join(' '));
        
        return avcC;
    }
    
    console.log('[VIDEO-DIAG] SPS or PPS not found, returning null');
    return null;
}

// 将 Annex-B 格式转换为 AVCC 格式
function annexBToAVCC(data, isKeyFrame) {
    const nalUnits = [];
    let i = 0;
    
    // 提取所有 NAL 单元
    while (i < data.length - 4) {
        let startCodeLength = 0;
        if (data[i] === 0 && data[i+1] === 0 && data[i+2] === 0 && data[i+3] === 1) {
            startCodeLength = 4;
        } else if (data[i] === 0 && data[i+1] === 0 && data[i+2] === 1) {
            startCodeLength = 3;
        } else {
            i++;
            continue;
        }
        
        const nalStart = i + startCodeLength;
        
        // 找到下一个起始码
        let nalEnd = nalStart + 1; // 从 nalStart + 1 开始搜索
        while (nalEnd < data.length - 3) {
            if ((data[nalEnd] === 0 && data[nalEnd+1] === 0 && data[nalEnd+2] === 0 && data[nalEnd+3] === 1) ||
                (data[nalEnd] === 0 && data[nalEnd+1] === 0 && data[nalEnd+2] === 1)) {
                break;
            }
            nalEnd++;
        }
        
        // 如果没找到下一个起始码，说明是最后一个 NAL
        if (nalEnd >= data.length - 3) {
            nalEnd = data.length;
        }
        
        const nalType = data[nalStart] & 0x1F;
        const nalSize = nalEnd - nalStart;
        
        // 跳过 SPS(7) 和 PPS(8)，它们已经在 description 中了
        // 注意：总是跳过，不管是否是关键帧
        if (nalType !== 7 && nalType !== 8) {
            nalUnits.push(data.slice(nalStart, nalEnd));
           
        } else {
            
        }
        
        i = nalEnd;
    }
    
    if (nalUnits.length === 0) {
        
        return new Uint8Array(0);
    }
    
    // 计算总大小
    let totalSize = 0;
    for (const nal of nalUnits) {
        totalSize += 4 + nal.length; // 4 字节长度 + NAL 数据
    }
    
    
    
    // 构建 AVCC 格式
    const avccData = new Uint8Array(totalSize);
    let offset = 0;
    
    for (const nal of nalUnits) {
        // 写入 NAL 长度（大端 4 字节）
        avccData[offset++] = (nal.length >> 24) & 0xFF;
        avccData[offset++] = (nal.length >> 16) & 0xFF;
        avccData[offset++] = (nal.length >> 8) & 0xFF;
        avccData[offset++] = nal.length & 0xFF;
        
        // 写入 NAL 数据
        avccData.set(nal, offset);
        offset += nal.length;
    }
    
    return avccData;
}

// 解析并解码 H.264 数据
async function decodeH264Data(data) {
    try {
        const extracted = extractH264Config(data);
        if (extracted) {
            console.log('[VIDEO-DIAG] Extracted SPS/PPS config (avcC). Size:', extracted.length);
            // 不再记录详细的 avcC hex，避免日志过多
            // console.log('[VIDEO-DIAG] Generated avcC hex:', Array.from(extracted).map(b => b.toString(16).padStart(2, '0')).join(' '));
            
            // ⚠️ 不再因为 SPS/PPS 变化而重新配置解码器
            // 因为我们使用 in-band SPS/PPS，解码器会自己处理
            if (!h264Description) {
                h264Description = extracted; // 只保存第一次的配置用于参考
                console.log('[VIDEO-DIAG] First SPS/PPS saved for reference');
            }
            // const same = h264Description && h264Description.length === extracted.length &&
            //              equalUint8(h264Description, extracted);
            // if (!same) {
            //     console.log('[VIDEO-DIAG] New SPS/PPS detected. Re-configuring decoder.');
            //     h264Description = extracted;
            //     if (videoDecoder && videoDecoder.state === 'configured') {
            //         try { videoDecoder.close(); } catch {}
            //         videoDecoder = null;
            //         decoderConfigured = false;
            //         pendingNalUnits = [];
            //         haveVclInCurrentAU = false;
            //         frameTimestamp = 0;
            //     }
            // }
        }
        
        // 配置解码器（如果还未配置）
        if (videoDecoder.state === 'unconfigured' && !decoderConfigured) {
            // 必须等待 SPS/PPS 才能配置
            if (!h264Description) {
                console.log('[VIDEO-DIAG] Waiting for SPS/PPS to configure decoder...');
                return;
            }
            
            console.log('[VIDEO-DIAG] Configuring decoder with Baseline Profile description');
            console.log('[VIDEO-DIAG] Description size:', h264Description.length);
            
            // 使用 Baseline Profile 的 description
            const config = {
                codec: 'avc1.42001E', // 强制使用 Baseline Profile codec 字符串
                description: h264Description, // 使用提取的 Baseline Profile SPS/PPS
                hardwareAcceleration: 'prefer-hardware',
            };
            
            try {
                const support = await VideoDecoder.isConfigSupported(config);
                
                console.log('[VIDEO-DIAG] Config support check result:', support);
                
                if (support.supported) {
                    console.log('[VIDEO-DIAG] ✅ Config is supported. Configuring...');
                    videoDecoder.configure(support.config);
                    decoderConfigured = true;
                    console.log('[VIDEO-DIAG] ✅ VideoDecoder configured successfully with Baseline Profile description');
                } else {
                    // 尝试不带硬件加速
                    console.warn('[VIDEO-DIAG] Config with hardwareAcceleration not supported, trying without...');
                    const fallbackConfig = {
                        codec: 'avc1.42001E',
                        description: h264Description,
                    };
                    const fallbackSupport = await VideoDecoder.isConfigSupported(fallbackConfig);
                    
                    if (fallbackSupport.supported) {
                        console.log('[VIDEO-DIAG] ✅ Fallback config supported. Configuring...');
                        videoDecoder.configure(fallbackSupport.config);
                        decoderConfigured = true;
                        console.log('[VIDEO-DIAG] ✅ VideoDecoder configured with software decoding');
                    } else {
                        console.error('[VIDEO-DIAG] ❌ No configuration works! Browser may not support Baseline Profile');
                        return;
                    }
                }
            } catch (e) {
                console.error('[VIDEO-DIAG] Exception during decoder configuration:', e);
                return;
            }
        }
        
        if (videoDecoder.state !== 'configured') {
            return; // 等待配置完成
        }
        
        const nalUnits = extractNalUnits(data);
        for (const nal of nalUnits) {
            const t = nal.type;
            // ⚠️ 保留 SPS/PPS，因为解码器需要从流中提取它们
            // if (t === 7 || t === 8) continue; // 注释掉，保留 SPS/PPS
            if (t === 9) {
                if (haveVclInCurrentAU && pendingNalUnits.length) finalizeAccessUnit();
                pendingNalUnits = [];
                haveVclInCurrentAU = false;
                continue;
            }
            if (t >= 1 && t <= 5) {
                if (haveVclInCurrentAU && pendingNalUnits.length) {
                    finalizeAccessUnit();
                    pendingNalUnits = [];
                    haveVclInCurrentAU = false;
                }
                haveVclInCurrentAU = true;
            }
            pendingNalUnits.push(nal);
        }
        if (haveVclInCurrentAU && pendingNalUnits.length) {
            finalizeAccessUnit();
            pendingNalUnits = [];
            haveVclInCurrentAU = false;
        }
    } catch (e) {
        
    }
}

function equalUint8(a, b) {
    if (!a || !b) return false;
    if (a.length !== b.length) return false;
    for (let i = 0; i < a.length; i++) {
        if (a[i] !== b[i]) return false;
    }
    return true;
}

function extractNalUnits(data) {
    const units = [];
    let i = 0;
    while (i < data.length - 4) {
        let scl = 0;
        if (data[i] === 0 && data[i+1] === 0 && data[i+2] === 0 && data[i+3] === 1) scl = 4;
        else if (data[i] === 0 && data[i+1] === 0 && data[i+2] === 1) scl = 3;
        else { i++; continue; }
        const start = i + scl;
        let end = start + 1;
        while (end < data.length - 3) {
            if ((data[end] === 0 && data[end+1] === 0 && data[end+2] === 0 && data[end+3] === 1) ||
                (data[end] === 0 && data[end+1] === 0 && data[end+2] === 1)) break;
            end++;
        }
        if (end >= data.length - 3) end = data.length;
        const type = data[start] & 0x1F;
        units.push({ type, data: data.slice(start, end) });
        i = end;
    }
    return units;
}

function finalizeAccessUnit() {
    if (!videoDecoder || videoDecoder.state !== 'configured') return;
    if (!pendingNalUnits.length) return;
    let key = false;
    let total = 0;
    for (const n of pendingNalUnits) {
        if (n.type === 5) key = true;
        // ⚠️ 跳过 SPS/PPS，因为它们已经在 description 中了
        if (n.type !== 7 && n.type !== 8) {
            total += 4 + n.data.length;
        }
    }
    if (total <= 0) return;
    // 如果解码器刚配置完成，第一个解码的帧必须是关键帧
    if (videoDecoder.decodeQueueSize === 0 && !key) {
        keyFramesSkipped++;
        console.log(`[VIDEO-DIAG] Skipping non-key frame #${keyFramesSkipped}: decoder requires key frame after configuration (queueSize=${videoDecoder.decodeQueueSize})`);
        
        // 如果跳过了太多帧，请求关键帧
        if (keyFramesSkipped >= 10) {
            console.log('[VIDEO-DIAG] Skipped too many frames, requesting key frame...');
            requestKeyFrame();
        }
        
        return;
    }
    if (!key && videoDecoder.decodeQueueSize > 2) return;
    
    // 重置计数器当我们收到关键帧时
    if (key) {
        keyFramesSkipped = 0;
        console.log('[VIDEO-DIAG] Processing key frame - decoder should start displaying video');
    }
    const avcc = new Uint8Array(total);
    let off = 0;
    for (const n of pendingNalUnits) {
        // ⚠️ 跳过 SPS/PPS，因为它们已经在 description 中了
        if (n.type === 7 || n.type === 8) continue;
        
        const len = n.data.length;
        avcc[off++] = (len >>> 24) & 0xFF;
        avcc[off++] = (len >>> 16) & 0xFF;
        avcc[off++] = (len >>> 8) & 0xFF;
        avcc[off++] = len & 0xFF;
        avcc.set(n.data, off);
        off += len;
    }
    const ts = frameTimestamp;
    frameTimestamp += 33333;
    try {
        const chunk = new EncodedVideoChunk({ type: key ? 'key' : 'delta', timestamp: ts, data: avcc });
        console.log(`[VIDEO-DIAG] Decoding chunk. Type: ${chunk.type}, Size: ${chunk.byteLength}, TS: ${chunk.timestamp}, Queue: ${videoDecoder.decodeQueueSize}`);
        
        // 添加详细的 AVCC 数据诊断
        console.log(`[VIDEO-DIAG] AVCC first 20 bytes:`, Array.from(avcc.slice(0, 20)).map(b => b.toString(16).padStart(2, '0')).join(' '));
        console.log(`[VIDEO-DIAG] AVCC total size: ${avcc.length}, NAL units (excluding SPS/PPS):`, pendingNalUnits.filter(n => n.type !== 7 && n.type !== 8).map(n => `type ${n.type}: ${n.data.length}B`).join(', '));
        
        videoDecoder.decode(chunk);
        
        console.log(`[VIDEO-DIAG] Chunk submitted to decoder, queue size now: ${videoDecoder.decodeQueueSize}`);
    } catch (e) {
        console.error('[VIDEO-DIAG] Exception during decode():', e);
    }
}

// 初始化视频解码器(WebCodecs API)
function initVideoDecoder() {
    if (!('VideoDecoder' in window)) {
        console.warn('WebCodecs API not supported');
        return;
    }
    
    console.log('Initializing VideoDecoder...');
    
    videoDecoder = new VideoDecoder({
        output: (frame) => {
            console.log(`[VIDEO-DIAG] Frame decoded successfully! Resolution: ${frame.displayWidth}x${frame.displayHeight}, TS: ${frame.timestamp}`);
            console.log(`[VIDEO-DIAG] Frame details: codedWidth=${frame.codedWidth}, codedHeight=${frame.codedHeight}, displayWidth=${frame.displayWidth}, displayHeight=${frame.displayHeight}`);
            // 在 canvas 上绘制解码后的帧
            frameCount++;
            
            
            
            // 设置 canvas 内部分辨率为视频实际分辨率
            const videoWidth = frame.displayWidth;
            const videoHeight = frame.displayHeight;
            
            if (canvas.width !== videoWidth || canvas.height !== videoHeight) {
                canvas.width = videoWidth;
                canvas.height = videoHeight;
                
                // 计算自适应显示尺寸
                adjustCanvasSize();
                
                console.log(`Video resolution: ${videoWidth}x${videoHeight}`);
            }
            
            // 绘制帧
            ctx.drawImage(frame, 0, 0, videoWidth, videoHeight);
            console.log('[VIDEO-DIAG] Frame drawn to canvas.');
            frame.close();
            
            // 计算帧率
            const now = performance.now();
            if (lastFrameTime > 0) {
                const fps = 1000 / (now - lastFrameTime);
                // 减少日志：每 60 帧记录一次
                if (frameCount % 60 === 0) {
                    console.log(`Decoded ${frameCount} frames, FPS: ${fps.toFixed(1)}`);
                }
            }
            lastFrameTime = now;
            
            // 隐藏加载提示
            document.getElementById('loading').style.display = 'none';
        },
        error: (e) => {
            console.error('[VIDEO-DIAG] FATAL DECODER ERROR:', e, e.message);
            try {
                if (videoDecoder && videoDecoder.state === 'configured') {
                    videoDecoder.close();
                }
            } catch {}
            videoDecoder = null;
            decoderConfigured = false;
            h264Description = null;
            pendingNalUnits = [];
            haveVclInCurrentAU = false;
            frameTimestamp = 0;
            showError(`Video decoder error: ${e.message}. Resetting decoder.`);
        }
    });
    
    // 不预先配置，等待第一个关键帧时动态配置
    console.log('VideoDecoder created, waiting for keyframe to configure...');
}

// 显示错误信息
function showError(message) {
    const videoContainer = document.getElementById('videoContainer');
    const errorDiv = document.createElement('div');
    errorDiv.style.cssText = 'position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #e74c3c; background: rgba(0,0,0,0.8); padding: 20px; border-radius: 5px; max-width: 80%;';
    errorDiv.textContent = message;
    videoContainer.appendChild(errorDiv);
    
    setTimeout(() => {
        errorDiv.remove();
    }, 5000);
}

// 更新设备列表
function updateDeviceList(devices) {
    const deviceList = document.getElementById('deviceList');
    const statsInfo = document.getElementById('statsInfo');
    
    if (devices.length === 0) {
        deviceList.innerHTML = '<li class="no-device">等待控制台连接...</li>';
        statsInfo.textContent = '控制台: 0 | 设备: 0';
        return;
    }
    
    // 统计控制台数量
    const consoleIds = new Set(devices.map(d => d.consoleId));
    statsInfo.textContent = `控制台: ${consoleIds.size} | 设备: ${devices.length}`;
    
    deviceList.innerHTML = '';
    devices.forEach(device => {
        const li = document.createElement('li');
        li.className = 'device-item';
        if (currentDevice === device.id) {
            li.classList.add('selected');
        }
        
        const statusClass = device.status || 'ready';
        const statusText = {
            'ready': '就绪',
            'streaming': '推流中',
            'starting': '启动中'
        }[statusClass] || '未知';
        
        li.innerHTML = `
            <div class="device-name">${device.model || device.serial}</div>
            <div class="device-info">序列号: ${device.serial}</div>
            <div class="device-info">状态: ${device.state}</div>
            <span class="device-status ${statusClass}">${statusText}</span>
        `;
        
        li.onclick = (evt) => selectDevice(device.id, evt);
        deviceList.appendChild(li);
    });
}

// 选择设备
function selectDevice(deviceId, evt) {
    console.log('Selecting device:', deviceId);
    currentDevice = deviceId;
    
    // 更新 UI
    document.querySelectorAll('.device-item').forEach(item => {
        item.classList.remove('selected');
    });
    if (evt && evt.target) {
        const item = evt.target.closest('.device-item');
        if (item) item.classList.add('selected');
    }
    
    // 通知服务器
    if (ws && ws.readyState === WebSocket.OPEN) {
        const message = {
            type: 'selectDevice',
            deviceId: deviceId
        };
        console.log('Sending selectDevice message:', message);
        ws.send(JSON.stringify(message));
    } else {
        console.error('WebSocket not connected');
    }
    
    // 显示视频区域
    document.getElementById('noDevice').style.display = 'none';
    document.getElementById('videoCanvas').style.display = 'block';
    document.getElementById('loading').style.display = 'flex';
    
    console.log('Waiting for video stream...');
    
    setTimeout(() => {
        document.getElementById('loading').style.display = 'none';
    }, 2000);
}

// 发送控制指令
function sendControl(action) {
    if (!currentDevice) {
        alert('请先选择一个设备');
        return;
    }
    
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({
            type: 'control',
            action: action
        }));
    }
}

// 断开连接
function disconnect() {
    currentDevice = null;
    document.getElementById('noDevice').style.display = 'block';
    document.getElementById('videoCanvas').style.display = 'none';
    document.querySelectorAll('.device-item').forEach(item => {
        item.classList.remove('selected');
    });
}

// 更新连接状态
function updateStatus(connected, text) {
    const statusDot = document.getElementById('statusDot');
    const statusText = document.getElementById('statusText');
    
    if (connected) {
        statusDot.classList.add('connected');
    } else {
        statusDot.classList.remove('connected');
    }
    
    statusText.textContent = text;
}

// Canvas 鼠标事件处理（模拟触摸）
let isMouseDown = false;

canvas.addEventListener('mousedown', (e) => {
    isMouseDown = true;
    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    
    sendTouchEvent('down', x, y);
});

canvas.addEventListener('mousemove', (e) => {
    if (!isMouseDown) return;
    
    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    
    sendTouchEvent('move', x, y);
});

canvas.addEventListener('mouseup', (e) => {
    if (!isMouseDown) return;
    isMouseDown = false;
    
    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    
    sendTouchEvent('up', x, y);
});

// 发送触摸事件
function sendTouchEvent(type, x, y) {
    if (!currentDevice) return;
    
    // 获取视频实际分辨率
    const videoWidth = canvas.width;  // Canvas 内部分辨率 = 视频分辨率
    const videoHeight = canvas.height;
    
    // 转换为绝对坐标
    const absX = Math.floor(x * videoWidth);
    const absY = Math.floor(y * videoHeight);
    
    // 减少日志：只记录 down 和 up 事件
    if (type === 'down' || type === 'up') {
        console.log(`Touch ${type}: abs=(${absX}, ${absY})`);
    }
    
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({
            type: 'control',
            action: 'touch',
            touchType: type,
            x: absX,
            y: absY,
            width: videoWidth,
            height: videoHeight
        }));
    }
}

// 页面加载时连接
window.addEventListener('load', () => {
    loadUserInfo();
    connectToServer();
});

// 加载用户信息
async function loadUserInfo() {
    try {
        const response = await fetch('/api/user');
        if (response.ok) {
            const data = await response.json();
            if (data.user) {
                document.getElementById('username').textContent = data.user.username;
            }
        } else if (response.status === 401) {
            // 未授权，重定向到登录页
            window.location.href = '/login';
        }
    } catch (error) {
        console.error('加载用户信息失败:', error);
    }
}

// 退出登录
async function logout() {
    try {
        const response = await fetch('/api/logout', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        if (response.ok) {
            // 关闭WebSocket连接
            if (ws && ws.readyState === WebSocket.OPEN) {
                ws.close();
            }
            // 重定向到登录页
            window.location.href = '/login';
        } else {
            console.error('退出登录失败');
        }
    } catch (error) {
        console.error('退出登录错误:', error);
    }
}

// 绑定退出登录按钮
document.addEventListener('DOMContentLoaded', () => {
    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', logout);
    }
});
